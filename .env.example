# Copy to .env for docker compose. NEVER commit the real .env file.
POSTGRES_PASSWORD=change-me-local-only
# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-48-characters-or-more
# Optional: creates an administrator at startup (password 8-72 characters)
ADMIN_EMAIL=
ADMIN_PASSWORD=
